<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <springProperty scope="context" name="activeProfile" source="spring.profiles.active" defaultValue="unknown"/>

    <!-- ── Local: keep Spring Boot's default human-readable console output ── -->
    <springProfile name="local">
        <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.skipq" level="DEBUG"/>
        <logger name="org.springframework.web.servlet.DispatcherServlet" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

    <!-- ── Dev + Prod: structured JSON console output ── -->
    <springProfile name="dev,prod">

        <conversionRule conversionWord="gcpSeverity"
                        class="com.skipq.core.logging.CloudSeverityConverter"/>

        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <!-- GCP expects "time" and "severity" at the top level -->
                    <timestamp>
                        <fieldName>time</fieldName>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <pattern>
                        <pattern>{"severity": "%gcpSeverity", "env": "${activeProfile}"}</pattern>
                    </pattern>
                    <loggerName>
                        <fieldName>logger</fieldName>
                        <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
                    </loggerName>
                    <message/>
                    <!-- MDC fields (requestId, etc.) appear as top-level JSON keys -->
                    <mdc/>
                    <!-- Full stack trace on exceptions -->
                    <stackTrace>
                        <fieldName>stack_trace</fieldName>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerCause>20</maxDepthPerCause>
                            <shortenedClassNameLength>36</shortenedClassNameLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="JSON"/>
        </root>
        <logger name="com.skipq" level="INFO"/>
        <logger name="org.springframework.security.config" level="ERROR"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>

    </springProfile>

    <!-- ── Prod only: forward logs to New Relic ── -->
    <springProfile name="prod">

        <appender name="NEW_RELIC_BASE" class="com.newrelic.logging.logback.NewRelicAppender">
            <licenseKey>${NR_INGEST_LICENSE_KEY}</licenseKey>
            <!-- US region endpoint — change to log-api.eu.newrelic.com for EU accounts -->
            <logApiUrl>https://log-api.newrelic.com/log/v1</logApiUrl>
        </appender>

        <appender name="NEW_RELIC" class="com.newrelic.logging.logback.NewRelicAsyncAppender">
            <appender-ref ref="NEW_RELIC_BASE"/>
        </appender>

        <root level="WARN">
            <appender-ref ref="NEW_RELIC"/>
        </root>
        <logger name="com.skipq" level="INFO"/>

    </springProfile>

</configuration>
